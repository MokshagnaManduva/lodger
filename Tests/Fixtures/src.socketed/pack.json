{
  "format": 1,
  "identity": {
    "id": "test.socketed",
    "name": "Socketed",
    "version": "1.0.0",
    "author": "engine tests",
    "license": "CC0-1.0",
    "description": "Build fixture exercising all four bind modes: body, socket, float, overlay."
  },
  "stage": {
    "cell": {
      "w": 20,
      "h": 20
    },
    "bodyHeight": 14,
    "ground": {
      "x": 10,
      "y": 18
    }
  },
  "textures": {
    "body": {
      "strip": "art/body.png",
      "preload": true
    },
    "prop": {
      "strip": "art/prop.png"
    },
    "orb": {
      "strip": "art/orb.png"
    },
    "face": {
      "strip": "art/face.png"
    }
  },
  "clips": {
    "wave": {
      "texture": "body",
      "loop": "pingpong",
      "frames": [
        {
          "cell": 0,
          "ms": 150
        },
        {
          "cell": 1,
          "ms": 150
        },
        {
          "cell": 2,
          "ms": 150
        },
        {
          "cell": 3,
          "ms": 150
        }
      ]
    },
    "rest": {
      "texture": "body",
      "loop": "forever",
      "frames": [
        {
          "cell": 0,
          "ms": 1000,
          "anchors": {
            "hand": {
              "x": 16,
              "y": 11
            },
            "orbit": {
              "x": 4,
              "y": 8
            }
          }
        }
      ]
    },
    "hold": {
      "texture": "prop",
      "frames": [
        {
          "cell": 0,
          "ms": 500
        }
      ]
    },
    "orb_idle": {
      "texture": "orb",
      "loop": "pingpong",
      "frames": [
        {
          "cell": 0,
          "ms": 400
        },
        {
          "cell": 1,
          "ms": 400
        }
      ]
    },
    "blink": {
      "texture": "face",
      "frames": [
        {
          "cell": 0,
          "ms": 80
        },
        {
          "cell": 1,
          "ms": 80
        }
      ]
    }
  },
  "parts": [
    {
      "name": "body",
      "bind": {
        "mode": "body"
      }
    },
    {
      "name": "face",
      "z": 9,
      "hitTest": false,
      "hiddenIn": [
        "sleeping"
      ],
      "bind": {
        "mode": "overlay",
        "parent": "body",
        "clip": "blink"
      }
    },
    {
      "name": "prop",
      "z": 3,
      "bind": {
        "mode": "socket",
        "parent": "body",
        "anchor": "hand",
        "frames": "clip",
        "clip": "hold",
        "offset": {
          "x": 0,
          "y": -1
        }
      }
    },
    {
      "name": "orb",
      "z": -1,
      "bind": {
        "mode": "float",
        "parent": "body",
        "anchor": "orbit",
        "clip": "orb_idle",
        "rest": {
          "x": -2,
          "y": -1
        },
        "stiffness": 110,
        "damping": 13,
        "mass": 1.0,
        "maxOffset": 10,
        "sleepThreshold": 0.2,
        "bob": {
          "amplitudeX": 1,
          "amplitudeY": 2,
          "periodMs": 1800,
          "phase": 0.25
        }
      }
    }
  ],
  "initialState": "waving",
  "states": {
    "waving": {
      "clip": "wave",
      "duration": {
        "minMs": 1500,
        "maxMs": 2500
      },
      "next": [
        {
          "state": "walking",
          "weight": 3
        },
        {
          "state": "sleeping",
          "weight": 1
        }
      ],
      "interrupts": [
        {
          "on": {
            "user.idle": 4
          },
          "state": "sleeping"
        },
        {
          "on": "pointer.grab",
          "state": "held"
        },
        {
          "on": "perch.acquired",
          "state": "perched"
        }
      ]
    },
    "walking": {
      "clip": "wave",
      "motion": {
        "type": "walk",
        "speed": 60,
        "direction": "random"
      },
      "duration": {
        "minMs": 1500,
        "maxMs": 3000
      },
      "next": [
        {
          "state": "waving",
          "weight": 1
        }
      ],
      "interrupts": [
        {
          "on": {
            "user.idle": 4
          },
          "state": "sleeping"
        },
        {
          "on": {
            "edge.reached": "left"
          },
          "state": "waving"
        },
        {
          "on": {
            "edge.reached": "right"
          },
          "state": "waving"
        },
        {
          "on": "pointer.grab",
          "state": "held"
        },
        {
          "on": "perch.acquired",
          "state": "perched"
        }
      ]
    },
    "held": {
      "clip": "wave",
      "motion": {
        "type": "drag"
      },
      "surface": "air",
      "interrupts": [
        {
          "on": "pointer.release",
          "state": "falling"
        }
      ]
    },
    "falling": {
      "clip": "wave",
      "motion": {
        "type": "fall",
        "gravity": 1400,
        "terminal": 900
      },
      "surface": "air",
      "interrupts": [
        {
          "on": "physics.landed",
          "state": "waving"
        },
        {
          "on": "pointer.grab",
          "state": "held"
        },
        {
          "on": "perch.acquired",
          "state": "perched"
        }
      ]
    },
    "sleeping": {
      "clip": "rest",
      "quiescent": true,
      "interrupts": [
        {
          "on": {
            "pointer.fast": 800
          },
          "state": "waving"
        },
        {
          "on": "pointer.click",
          "state": "waving"
        },
        {
          "on": "pointer.grab",
          "state": "held"
        },
        {
          "on": "perch.acquired",
          "state": "perched"
        }
      ]
    },
    "perched": {
      "clip": "wave",
      "surface": "windowTop",
      "duration": {
        "minMs": 4000,
        "maxMs": 9000
      },
      "next": [
        {
          "state": "perched",
          "weight": 1
        }
      ],
      "interrupts": [
        {
          "on": "perch.lost",
          "state": "falling"
        },
        {
          "on": "pointer.grab",
          "state": "held"
        }
      ]
    }
  },
  "requires": [
    "windowEdges"
  ]
}